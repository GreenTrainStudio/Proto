leID="s6081"><Data ss:Type="String">Phone: +375447773741</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1">    <Cell ss:MergeAcross="1" ss:MergeDown="0" ss:StyleID="s6081"><Data ss:Type="String">Email: vadzim.karobkin@yandex.by</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1">   </Row>   <Row ss:AutoFitHeight="1">    <Cell ss:MergeAcross="1" ss:MergeDown="0" ss:StyleID="s6081"><Data ss:Type="String">Date: 30 April 2026</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1">   </Row>   <Row ss:AutoFitHeight="1">    <Cell ss:MergeAcross="1" ss:StyleID="s6087"><Data ss:Type="String">Description and period of placement</Data></Cell>    <Cell ss:StyleID="s6087"><Data ss:Type="String">Amount, US Dollars</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1" ss:Height="30">    <Cell ss:MergeAcross="1" ss:StyleID="s6085"><Data ss:Type="String">Remuneration payable for services under the Agreement for the accounting period April, 2026</Data></Cell>    <Cell ss:StyleID="s6086"><Data ss:Type="String">195.42</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1">    <Cell ss:MergeAcross="1" ss:StyleID="s6082"><Data ss:Type="String">Total:</Data></Cell>    <Cell ss:StyleID="s6086"><Data ss:Type="String">195.42</Data></Cell>   </Row>   <Row ss:AutoFitHeight="1">   </Row>   <Row ss:Height="38">    <Cell ss:MergeAcross="2" ss:StyleID="s6081"><Data ss:Type="String">1. Payable to the Partner is 195.42 US Dollars (One Hundred Ninety-Five US Dollars 42 cents).</Data></Cell>   </Row>   <Row ss:Height="38">    <Cell ss:MergeAcross="2" ss:StyleID="s6081"><Data ss:Type="String">2. The remuneration payable (net amount) is determined in accordance with Yandex Statistical Data available to the Partner through the Partner Interface.</Data></Cell>   </Row>   <Row ss:Height="83">    <Cell ss:MergeAcross="2" ss:StyleID="s6081"><Data ss:Type="String">3. In accordance with Section 4 of the Offer at https://yandex.com/legal/yan_service_offer_arm (Agreement) the Partner's scope of services and remuneration pa